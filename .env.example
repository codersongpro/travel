# ─────────────────────────────────────────────────────────────
# 이 앱은 키가 하나도 없어도 "샘플 데이터 모드"로 전부 동작합니다.
# 아래 키를 채울수록 해당 영역이 실제 데이터로 바뀝니다.
# ─────────────────────────────────────────────────────────────

# [1] 일정 생성 (Gemini) — https://aistudio.google.com/apikey
# 없으면: 규칙 기반 샘플 일정이 생성됩니다.
GEMINI_API_KEY=

# [2] 장소 검색 + 실제 이동시간 (서버 전용)
# Google Cloud Console에서 아래 두 API를 모두 활성화한 뒤 키를 발급하세요.
#   - Places API (New)
#   - Routes API
# 주의: AI Studio에서 발급한 GEMINI_API_KEY로는 이 API들을 호출할 수 없습니다.
# 없으면: 샘플 장소 후보 + Haversine 추정 이동시간으로 동작합니다.
GOOGLE_MAPS_API_KEY=

# [3] 지도 렌더링 (브라우저 노출됨)
# Maps JavaScript API 활성화 + HTTP 리퍼러 제한을 반드시 설정하세요.
# 없으면: 지도 대신 좌표 기반 정적 목록이 표시됩니다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# [4] 숙소 검색 + 실제 1박 요금 — https://developers.amadeus.com
# 테스트 환경(test.api.amadeus.com)은 무료입니다.
# 없으면: 샘플 숙소 + 등급별 추정 요금으로 동작합니다.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test
